model VendorCategory {
  id       Int         @id @default(autoincrement())
  vendorId Int
  vendor   VendorAdmin @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  categoryName  String
  image         String?
  status        String              @default("ACTIVE") // ACTIVE | INACTIVE
  products      Product[]
  subCategories VendorSubCategory[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model VendorAdmin {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vendorBrands     VendorBrand[]
 
  vendorCategories VendorCategory[]
}

model VendorBrand {
  id       Int         @id @default(autoincrement())
  vendorId Int
  vendor   VendorAdmin @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  brandName String
  image     String?
  status    String    @default("ACTIVE") // ACTIVE | INACTIVE
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model VendorSubCategory {
  id               Int                    @id @default(autoincrement())
  vendorId         Int
  categoryId       Int
  category         VendorCategory         @relation(fields: [categoryId], references: [id])
  subCategoryName  String
  image            String?
  status           String                 @default("ACTIVE")
  subSubCategories VendorSubSubCategory[]
  products         Product[]
  createdAt        DateTime               @default(now())
}

model VendorSubSubCategory {
  id                 Int               @id @default(autoincrement())
  vendorId           Int
  subCategoryId      Int
  subCategory        VendorSubCategory @relation(fields: [subCategoryId], references: [id])
  subSubCategoryName String
  image              String?
  status             String            @default("ACTIVE")
  products           Product[]
  createdAt          DateTime          @default(now())
}

model Product {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   vendorId Int
  vendor   WebVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Category
  categoryId Int
  category   VendorCategory @relation(fields: [categoryId], references: [id])

  // Sub Category
  subCategoryId Int?
  subCategory   VendorSubCategory? @relation(fields: [subCategoryId], references: [id])

  // Sub Sub Category
  subSubCategoryId Int?
  subSubCategory   VendorSubSubCategory? @relation(fields: [subSubCategoryId], references: [id])

  // Brand
  brandId Int?
  brand   VendorBrand? @relation(fields: [brandId], references: [id])

  // Product
  productName String
  sku         String @unique

  productType ProductType @default(SIMPLE)
  stock       StockStatus @default(IN_STOCK)

  keywords         String?
  shortDescription String?
  keyFeatures      Json?
  videoUrl         String?

  // Price
// Price
mrp          Decimal @db.Decimal(10, 2)
sellingPrice Decimal @db.Decimal(10, 2)
tax          Decimal @default(0) @db.Decimal(5, 2)
discount     Decimal @default(0) @db.Decimal(5, 2)
finalPrice   Decimal @db.Decimal(10, 2)

  // Stock
  stockQuantity    Int     @default(0)
  barcode          String?
  unit             String?
  weight           String?
  maxOrderQuantity Int     @default(1)
  partNumber       String?
  oemNumber        String?
  countryOfOrigin  String?
  // Images
  mainImage        String?
  thumbnailImage   String?
  additionalImages Json?

  // Product Details
  productCondition      ProductCondition @default(NEW)
  manufacturingDate     DateTime?
  expiryDate            DateTime?
  returnPolicy          ReturnPolicy     @default(NONE)
  estimatedDeliveryTime String?
  freeShipping          Boolean          @default(false)
  warrantyPeriod        String?
  warrantyDetails       String?
  specifications        Json?
 cartItems      CartItem[]
 webOrderItems  WebOrderItem[]
  // Verification
  verificationStatus ProductVerificationStatus @default(PENDING)
  rejectionReason    String?
 wishlistedBy Wishlist[] 
  @@index([vendorId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([subSubCategoryId])
  @@index([brandId])
  @@index([verificationStatus])
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

enum ProductCondition {
  NEW
  USED
}

enum ReturnPolicy {
  NONE
  DAYS_7
  DAYS_15
  DAYS_30
}

enum ProductVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}
model Cart {
  id         Int        @id @default(autoincrement())
  webUserId  Int        @unique
  webUser    WebUser    @relation(fields: [webUserId], references: [id], onDelete: Cascade)
  couponCode String?
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Coupon {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  type      CouponType
  discount  Decimal    @db.Decimal(10, 2)
  minAmount Decimal    @default(0) @db.Decimal(10, 2)
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model WebOrder {
  id             Int              @id @default(autoincrement())
  orderNumber    String           @unique
  webUserId      Int
  webUser        WebUser          @relation(fields: [webUserId], references: [id])
  items          WebOrderItem[]

  subtotal       Decimal          @db.Decimal(10, 2)
  cgst           Decimal          @db.Decimal(10, 2)
  sgst           Decimal          @db.Decimal(10, 2)
  shippingCharge Decimal          @db.Decimal(10, 2)
  discountAmount Decimal          @default(0) @db.Decimal(10, 2)
  couponCode     String?
  totalAmount    Decimal          @db.Decimal(10, 2)

  paymentMethod  WebPaymentMethod @default(COD)
  paymentStatus  WebPaymentStatus @default(PENDING)
  orderStatus    WebOrderStatus   @default(PLACED)

  // shipping snapshot
  fullName String
  phone    String
  email    String
  address  String
  city     String
  state    String
  pincode  String
  landmark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([webUserId])
}

model WebOrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       WebOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  productName String   // snapshot
  partNumber  String?
  price       Decimal  @db.Decimal(10, 2) // snapshot finalPrice at order time
  quantity    Int
  itemStatus        WebOrderItemStatus @default(PLACED)
  cancelReason       String?
  cancelDescription  String?           @db.Text
  cancelImages       Json?             // array of image URLs, e.g. ["/uploads/order-cancellations/xyz.jpg"]
  cancelRequestedAt  DateTime?
}

enum WebPaymentMethod {
  COD
  ONLINE
}

enum WebPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum WebOrderStatus {
  PLACED
  CONFIRMED
  PACKAGING
  OUT_FOR_DELIVERY
  SHIPPED
  DELIVERED
  CANCELLED
}
