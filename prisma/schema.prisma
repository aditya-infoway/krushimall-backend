  oppAccount   Account @relation("BankPaymentOppAccount", fields: [oppAccountId], references: [id])

  purchaseId Int?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

