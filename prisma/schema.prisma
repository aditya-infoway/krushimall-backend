model QuotationHistory {
  id Int @id @default(autoincrement())

  leadId Int

  quotationNo String
  revisionNo  Int

  modelId           Int?
  showroomVariantId Int?
  colourId          Int?

  exShowroomAmount  Float @default(0)
  insuranceAmount   Float @default(0)
  rtoAmount         Float @default(0)
  accessoriesAmount Float @default(0)
  grandTotal        Float @default(0)

  // Only toggle-ON accessories are stored
  selectedAccessories Json?

  updatedBy String?

  createdAt DateTime @default(now())

   lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  model           Model?           @relation(fields: [modelId], references: [id])
  showroomVariant ShowroomVariant? @relation(fields: [showroomVariantId], references: [id])
  colour          Colour?          @relation(fields: [colourId], references: [id])
  @@unique([leadId, revisionNo])
  @@index([leadId])
}

model Order {
  id Int @id @default(autoincrement())

  // Company Relation
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  // Financial Year Relation
  financialYearId Int
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  // Lead Relation
  leadId Int  @unique
  lead   Lead @relation(fields: [leadId], references: [id])

  // Vehicle Charges
  exShowroomPrice       Float @default(0)
  insurance             Float @default(0)
  roadSideAssistance    Float @default(0)
  exWarranty2_3         Float @default(0)
  hypothecationCharges  Float @default(0)
  exWarranty2_8         Float @default(0)
  rtoRegistrationCharge Float @default(0)
  rtoOtherCharge        Float @default(0)

  // Allotment Details
  model               String?
  variant             String?
  colour              String?
  chassisNo           String?
  policyNo            String?
  nomineeName         String?
  nomineeDob          DateTime?
  relationWithNominee String?

  // Hypothecation
  hypothecationType String?

  // Finance Relation
  financeDoneBy Int?
  finance       Finance? @relation(fields: [financeDoneBy], references: [id])

  bankOfFinance    String?
  financeAmount    Float   @default(0)
  emi              Float   @default(0)
  tenureMonths     Int     @default(0)
  processingCharge Float   @default(0)
  loanRoi          Float   @default(0)
  marginMoney      Float   @default(0)
  paymentStatus    String  @default("pending")
  assignBy         String?

  // Cash Payment
  cashAmount Float @default(0)

  // Cash Account Relation
  cashAccountId Int?
  cashAccount   Account? @relation("OrderCashAccount", fields: [cashAccountId], references: [id])

  // Bank Payment
  bankAmount Float @default(0)

  // Bank Account Relation
  bankAccountId Int?
  bankAccount   Account? @relation("OrderBankAccount", fields: [bankAccountId], references: [id])

  paymentMode String?
  chequeNo    String?
  chequeDate  DateTime?
  clearDate   DateTime?
  narration   String?

  // Exchange Details
  existingCustomerModel   String?
  existingCustomerVariant String?
  existingVehicleYear     String?
  customerExpectedPrice   Float   @default(0)
  marketPrice             Float   @default(0)
  exchangeChassisNo       String?
  companyShare            Float   @default(0)
  dealerShares            Float   @default(0)
  rcNo                    String?
  exchangeInsurance       String?
  vehicleNo               String?

  // Payment Details
  discount         Float @default(0)
  schemeDiscount   Float @default(0)
  exchangeDiscount Float @default(0)
  invoiceAmount    Float @default(0)
  total            Float @default(0)
  receivedAmount   Float @default(0)
  pendingAmount    Float @default(0)

  // Broker Details
  brokerName   String?
  brokerAmount Float   @default(0)

  // Delivery Challan
  invoiceBill        Boolean @default(false)
  accessoriesInvoice Boolean @default(false)
  serviceBook        Boolean @default(false)
  insuranceCopy      Boolean @default(false)
  helmetInvoice      Boolean @default(false)
  warrantyBook       Boolean @default(false)
  keychainPouch      Boolean @default(false)
  allGuard           Boolean @default(false)
  matting            Boolean @default(false)
  footrest           Boolean @default(false)
  helmet             Boolean @default(false)
  visor              Boolean @default(false)
  seatCover          Boolean @default(false)
  bodyCover          Boolean @default(false)
  mirrorSet          Boolean @default(false)
  other              Boolean @default(false)

  createdBy   String?
  createdType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([financialYearId])
  @@index([chassisNo])
  @@index([cashAccountId])
  @@index([bankAccountId])
  @@index([financeDoneBy])
}
