generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Admin {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  role        String   @default("Admin")
  password    String
  activeToken String?
  createdAt   DateTime @default(now())
}

model Company {
  id                    Int                    @id @default(autoincrement())
  companyName           String
  country               String
  state                 String
  stateCode             String
  district              String
  city                  String
  email                 String?
  accountNumber         String?
  quotationTerms        String?                @db.Text
  pincode               String
  addressLine1          String
  addressLine2          String?
  mobileNumber          String
  phoneNumber           String?
  gstNumber             String
  panNumber             String
  bankName              String
  bankHolderName        String
  ifscCode              String
  branchLocation        String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  logo                  String?
  financialYears        FinancialYear[]
  cashPayments          CashPayment[]
  purchases             Purchase[]
  bankPayments          BankPayment[]
  contras               Contra[]
  cashReceipts          CashReceipt[]
  bankReceipts          BankReceipt[]
  leads                 Lead[]
  branches              Branch[]
  vehicleStockTransfers VehicleStockTransfer[]
  accessoriesPurchases  AccessoriesPurchase[]
  orders                Order[]
}

model FinancialYear {
  id                    Int                    @id @default(autoincrement())
  companyId             Int
  companyName           String
  financialYear         String
  fyStartDate           DateTime
  fyEndDate             DateTime
  createdAt             DateTime               @default(now())
  company               Company                @relation(fields: [companyId], references: [id])
  cashPayments          CashPayment[]
  purchases             Purchase[]
  bankPayments          BankPayment[]
  contras               Contra[]
  cashReceipts          CashReceipt[]
  bankReceipts          BankReceipt[]
  leads                 Lead[]
  branches              Branch[]
  vehicleStockTransfers VehicleStockTransfer[]
  accessoriesPurchases  AccessoriesPurchase[]
  orders                Order[]

  @@unique([companyId, financialYear])
}

model Category {
  id                  Int                  @id @default(autoincrement())
  categoryName        String               @unique
  status              String               @default("ACTIVE")
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  brands              Brand[]
  models              Model[]
  modelYears          ModelYear[]
  variants            Variant[]
  websiteVariants     WebsiteVariant[]
  usedWebsiteVariants UsedWebsiteVariant[]
}

model Brand {
  id                  Int                  @id @default(autoincrement())
  categoryId          Int
  brandName           String
  image               String?
  status              String               @default("ACTIVE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  category            Category             @relation(fields: [categoryId], references: [id])
  models              Model[]
  modelYears          ModelYear[]
  variants            Variant[]
  websiteVariants     WebsiteVariant[]
  usedWebsiteVariants UsedWebsiteVariant[]
}

model Model {
  id                  Int                  @id @default(autoincrement())
  categoryId          Int
  brandId             Int
  modelName           String
  image               String?
  status              String               @default("ACTIVE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  colours             Colour[]
  leads               Lead[]
  brand               Brand                @relation(fields: [brandId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  modelYears          ModelYear[]
  showroomVariants    ShowroomVariant[]
  tractors            Tractor[]
  variants            Variant[]
  websiteVariants     WebsiteVariant[]
  quotationHistories  QuotationHistory[]
  testDrives          TestDrive[]
  usedWebsiteVariants UsedWebsiteVariant[]
}

model ModelYear {
  id                  Int                  @id @default(autoincrement())
  categoryId          Int
  brandId             Int
  modelId             Int
  modelYear           String
  image               String?
  status              String               @default("ACTIVE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  brand               Brand                @relation(fields: [brandId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  model               Model                @relation(fields: [modelId], references: [id])
  variants            Variant[]
  websiteVariants     WebsiteVariant[]
  usedWebsiteVariants UsedWebsiteVariant[]
}

model ShowroomVariant {
  id Int @id @default(autoincrement())

  modelId   Int
  variantId Int?

  variantName String

  purPrice      Float
  purTaxPercent Float

  exShowroomPrice      Float
  exShowroomTaxPercent Float

  insurance           Float
  insuranceTaxPercent Float

  rtoCharge     Float
  rtoTaxType    String
  rtoTaxPercent Float

  salesPrice Float

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  model     Model    @relation(fields: [modelId], references: [id])
  variant   Variant? @relation(fields: [variantId], references: [id])

  accessories ShowroomVariantAccessory[]

  colours            Colour[]
  leads              Lead[]
  tractors           Tractor[]
  quotationHistories QuotationHistory[]
  testDrives         TestDrive[]

  @@unique([modelId, variantId])
}

model ShowroomVariantAccessory {
  id                Int             @id @default(autoincrement())
  showroomVariantId Int
  accessoryId       Int
  qty               Int             @default(1)
  price             Float
  taxPercent        Float
  totalPrice        Float
  createdAt         DateTime        @default(now())
  accessory         Accessory       @relation(fields: [accessoryId], references: [id])
  showroomVariant   ShowroomVariant @relation(fields: [showroomVariantId], references: [id], onDelete: Cascade)
}

model Variant {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  brandId     Int
  modelId     Int
  modelYearId Int
  variantCode String   @unique
  variantName String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       String?
  colours     Colour[]
  leads       Lead[]

  brand               Brand                @relation(fields: [brandId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  model               Model                @relation(fields: [modelId], references: [id])
  modelYear           ModelYear            @relation(fields: [modelYearId], references: [id])
  websiteVariants     WebsiteVariant[]
  showroomVariants    ShowroomVariant[]
  usedWebsiteVariants UsedWebsiteVariant[]
}

model WebsiteVariant {
  id                        Int              @id @default(autoincrement())
  currentStep               Int              @default(1)
  status                    String           @default("DRAFT")
  isCompleted               Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  vendorId                  Int?
  vendor                    WebVendor?       @relation(fields: [vendorId], references: [id])
  createdById               Int?
  createdBy                 String?
  createdType               String?
  categoryId                Int?
  brandId                   Int?
  modelId                   Int?
  modelYearId               Int?
  variantId                 Int?
  variantCode               String?
  productCode               String?
  skuCode                   String?
  country                   String?
  tractorStatus             String?
  driveType                 String?
  shortDescription          String?
  highlight1                String?
  highlight2                String?
  highlight3                String?
  highlight4                String?
  highlight5                String?
  redColor                  Boolean          @default(false)
  blueColor                 Boolean          @default(false)
  greenColor                Boolean          @default(false)
  orangeColor               Boolean          @default(false)
  blackColor                Boolean          @default(false)
  whiteColor                Boolean          @default(false)
  customColor               Boolean          @default(false)
  customColorName           String?
  customColorCode           String?
  availableStates           Json?
  availableDistricts        Json?
  availableDealers          Json?
  stockStatus               String?
  seoTitle                  String?
  seoUrl                    String?
  metaDescription           String?
  keywords                  String?
  engineType                String?
  fuelType                  String?
  horsePower                Int?
  numberOfCylinders         String?
  cubicCapacity             Int?
  ratedRpm                  Int?
  aspiratedType             String?
  emissionNorms             String?
  coolingSystem             String?
  airFilterType             String?
  maximumTorque             Float?
  torqueRpm                 Float?
  torqueBackup              Float?
  engineCondition           String?
  clutchType                String?
  forwardGears              Int?
  reverseGears              Int?
  gearType                  String?
  transmissionType          String?
  ptoHp                     Int?
  ptoRpm                    Int?
  ptoType                   String?
  ptoPosition               String?
  creeperGears              Boolean          @default(false)
  shuttleShift              Boolean          @default(false)
  sideShiftGear             Boolean          @default(false)
  powerShuttle              Boolean          @default(false)
  hiLoGears                 Boolean          @default(false)
  multiSpeedPto             Boolean          @default(false)
  reversePto                Boolean          @default(false)
  superReducer              Boolean          @default(false)
  liftingCapacity           Int?
  liftingCapacityAt610mm    Int?
  hydraulicType             String?
  addc                      Boolean          @default(false)
  positionControl           Boolean          @default(false)
  draftControl              Boolean          @default(false)
  controlType               String?
  remoteValveType           String?
  numberOfRemoteValves      String?
  threePointLinkage         String?
  linkageCategory           String?
  topLink                   String?
  draftSensitivity          String?
  externalHydraulicCylinder Boolean          @default(false)
  selfLevelling             Boolean          @default(false)
  quickHitch                Boolean          @default(false)
  downPositionControl       Boolean          @default(false)
  loadSensing               Boolean          @default(false)
  flowControl               Boolean          @default(false)
  returnToDepth             Boolean          @default(false)
  transportLock             Boolean          @default(false)
  exShowroomPrice           Float?
  onRoadPrice               Float?
  currency                  String?
  gst                       Float?
  tcsApplicable             String?
  tcsPercentage             Float?
  financeAvailable          String?
  emiAvailable              String?
  downPayment               Float?
  offerPrice                Float?
  negotiable                String?
  exchangeOffer             String?
  state                     String?
  district                  String?
  taluka                    String?
  city                      String?
  pincode                   String?
  landmark                  String?
  fullAddress               String?
  searchLocation            String?
  latitude                  Float?
  longitude                 Float?
  frontView                 String?
  leftView                  String?
  rightView                 String?
  rearView                  String?
  engineView                String?
  dashboardView             String?
  tyreView                  String?
  hydraulicView             String?
  ptoView                   String?
  chassisNumber             String?
  rcBook                    String?
  additionalImage1          String?
  additionalImage2          String?
  additionalImage3          String?
  additionalImage4          String?
  additionalImage5          String?
  brochure                  String?
  warrantyCard              String?
  insuranceCertificate      String?
  invoice                   String?
  others                    String?
  agreed                    Boolean          @default(false)
  productName               String?
  launchYear                DateTime?
  brand                     Brand?           @relation(fields: [brandId], references: [id])
  category                  Category?        @relation(fields: [categoryId], references: [id])
  model                     Model?           @relation(fields: [modelId], references: [id])
  modelYear                 ModelYear?       @relation(fields: [modelYearId], references: [id])
  variant                   Variant?         @relation(fields: [variantId], references: [id])
  enquiries                 WebsiteEnquiry[]
  isUpcoming                Boolean          @default(false)
  enquiryCount              Int              @default(0)
  wishlistedBy              Wishlist[]
}

model Colour {
  id                 Int                @id @default(autoincrement())
  modelId            Int
  variantId          Int?
  colourName         String
  colourCode         String
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  showroomVariantId  Int?
  model              Model              @relation(fields: [modelId], references: [id])
  showroomVariant    ShowroomVariant?   @relation(fields: [showroomVariantId], references: [id])
  variant            Variant?           @relation(fields: [variantId], references: [id])
  leads              Lead[]
  tractors           Tractor[]
  quotationHistories QuotationHistory[]
  testDrives         TestDrive[]
}

model Account {
  id                   Int                   @id @default(autoincrement())
  accountName          String?
  printName            String?
  openingBalance       Float                 @default(0)
  drCr                 String?
  country              String?
  countryCode          String?
  state                String?
  stateCode            String?
  district             String?
  taluka               String?
  city                 String?
  area                 String?
  address1             String?
  address2             String?
  pincode              String?
  phone                String?
  mobile               String?
  email                String?
  contactPerson        String?
  birthday             DateTime?
  anniversary          DateTime?
  bankAccountNo        String?
  bankName             String?
  ifscCode             String?
  branch               String?
  gstNo                String?
  panCard              String?
  aadharNo             String?
  status               String                @default("ACTIVE")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  group                String?
  closingBalance       Float                 @default(0)
  accountLeads         Lead[]                @relation("LeadAccount")
  customerLeads        Lead[]                @relation("LeadCustomer")
  accessoriesPurchases AccessoriesPurchase[] @relation("AccessoriesPurchaseParty")

  cashAccessoriesPurchases AccessoriesPurchase[] @relation("AccessoriesPurchaseCash")

  bankAccessoriesPurchases AccessoriesPurchase[] @relation("AccessoriesPurchaseBank")
  bankReceiptBankAccounts  BankReceipt[]         @relation("BankReceiptBankAccount")
  bankReceiptOppAccounts   BankReceipt[]         @relation("BankReceiptOppAccount")
  Purchase                 Purchase[]
  purchaseCash             Purchase[]            @relation("PurchaseCash")
  purchaseBankAccounts     Purchase[]            @relation("PurchaseBank")
  cashPayments             CashPayment[]         @relation("CashPaymentCashAccount")
  oppPayments              CashPayment[]         @relation("CashPaymentOppAccount")
  bankPayments             BankPayment[]         @relation("BankPaymentBankAccount")
  oppBankPayments          BankPayment[]         @relation("BankPaymentOppAccount")
  contraCashBankAccounts   Contra[]              @relation("ContraCashBankAccount")
  contraOppAccounts        Contra[]              @relation("ContraOppAccount")
  cashReceiptsCash         CashReceipt[]         @relation("CashReceiptCash")
  cashReceiptsOpp          CashReceipt[]         @relation("CashReceiptOpp")
  branches                 Branch[]              @relation("BranchManager")
  orderCashAccounts        Order[]               @relation("OrderCashAccount")

  orderBankAccounts     Order[]                @relation("OrderBankAccount")
  vehicleStockTransfers VehicleStockTransfer[]

  createdType String?
  createdBy   String?
  createdById Int?
  branchId    Int?

  createdByBranch Branch? @relation("AccountBranch", fields: [branchId], references: [id])

  teamLeadId Int?
  teamLead   Employee? @relation("AccountTeamLead", fields: [teamLeadId], references: [id])

  employee Employee? @relation("AccountCreatedBy", fields: [createdById], references: [id])

  finances Finance[]

  @@index([createdById])
  @@index([teamLeadId])
}

model EnquiryType {
  id          Int      @id @default(autoincrement())
  enquiryType String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]
}

model EnquirySource {
  id            Int      @id @default(autoincrement())
  enquirySource String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  leads         Lead[]
}

model Profession {
  id         Int      @id @default(autoincrement())
  profession String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  leads      Lead[]
}

model Banker {
  id        Int      @id @default(autoincrement())
  banker    String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Finance {
  id Int @id @default(autoincrement())

  accountId Int
  account   Account @relation(fields: [accountId], references: [id])

  employeeName String
  orders       Order[]
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EnquiryStatus {
  id            Int      @id @default(autoincrement())
  enquiryStatus String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  leads         Lead[]
}

model Employee {
  id Int @id @default(autoincrement())

  department String
  branch     String
  role       String

  teamLeadId Int? // NEW

  employeeName    String
  mobileNumber    String  @unique
  alternateNumber String?
  email           String  @unique
  password        String

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdType String?
  createdBy   String?

  branchId        Int?
  createdByBranch Branch? @relation("EmployeeBranch", fields: [branchId], references: [id])
  leads           Lead[]  @relation("LeadExecutive")

  // Leads assigned to this Team Lead
  teamLeadLeads Lead[]    @relation("LeadTeamLead")
  teamLead      Employee? @relation("EmployeeTeamLead", fields: [teamLeadId], references: [id])

  teamMembers Employee[] @relation("EmployeeTeamLead")

  accounts Account[] @relation("AccountCreatedBy")

  teamLeadAccounts         Account[]                 @relation("AccountTeamLead")
  purchases                Purchase[]
  accessoriesPurchases     AccessoriesPurchase[]
  cashPayments             CashPayment[]             @relation("CashPaymentEmployee")
  bankPayments             BankPayment[]             @relation("BankPaymentEmployee")
  cashReceipts             CashReceipt[]             @relation("CashReceiptEmployee")
  bankReceipts             BankReceipt[]             @relation("BankReceiptEmployee")
  contras                  Contra[]                  @relation("ContraEmployee")
  accessoriesPurchaseItems AccessoriesPurchaseItem[] @relation("AccessoriesPurchaseItemEmployee")

  accessories Accessory[]
}

model Tractor {
  id Int @id @default(autoincrement())

  modelId Int
  model   Model @relation(fields: [modelId], references: [id])

  showroomVariantId Int
  showroomVariant   ShowroomVariant @relation(fields: [showroomVariantId], references: [id])

  colourId Int
  colour   Colour @relation(fields: [colourId], references: [id])

  itemName             String
  codeNo               String         @unique
  shortName            String?
  hsnCode              String?
  taxSlab              String?
  listOfGroup          String?
  typeOfFuel           String?
  fuelCapacity         String?
  purchasePriceNoGST   Float          @default(0)
  purchasePriceTaxable Float          @default(0)
  status               String         @default("ACTIVE")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  purchaseItems        PurchaseItem[]
}

model ProfilePrefix {
  id        Int      @id @default(autoincrement())
  prefixFor String   @unique
  prefix    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id               Int            @id @default(autoincrement())
  companyId        Int?
  financialYearId  Int?
  createdById      Int?
  createdBy        String?
  createdType      String?
  employee         Employee?      @relation(fields: [createdById], references: [id])
  company          Company?       @relation(fields: [companyId], references: [id])
  financialYear    FinancialYear? @relation(fields: [financialYearId], references: [id])
  billNo           String         @unique
  accountId        Int?
  account          Account?       @relation(fields: [accountId], references: [id])
  cashAccountId    Int?
  cashAccount      Account?       @relation("PurchaseCash", fields: [cashAccountId], references: [id])
  bankAccountId    Int?
  bankAccount      Account?       @relation("PurchaseBank", fields: [bankAccountId], references: [id])
  purchaseDate     DateTime?
  purchaseBillNo   String?
  purchaseLocation String?
  dueDate          DateTime?
  terms            String?
  narration        String?
  freightCharge    Float          @default(0)
  insurance        Float          @default(0)
  otherCharge      Float          @default(0)
  roundAmount      Float          @default(0)
  totalQty         Int            @default(0)
  totalAmount      Float          @default(0)
  grandTotal       Float          @default(0)
  cgst             Float          @default(0)
  sgst             Float          @default(0)
  igst             Float          @default(0)

  paymentMode String?

  chequeNo   String?
  chequeDate DateTime?
  clearDate  DateTime?

  bankNarration   String?
  transporterName String?
  mobileNumber    String?
  vehicleNumber   String?
  status          String   @default("NOT_VERIFY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items        PurchaseItem[]
  cashPayments CashPayment[]
  bankPayments BankPayment[]
}

model PurchaseItem {
  id         Int @id @default(autoincrement())
  purchaseId Int

  itemName  String
  itemCode  String
  shortName String?
  hsnCode   String?
  taxSlab   String?
  groupName String?

  modelName   String?
  variantName String?
  color       String?

  fuelType     String?
  fuelCapacity String?

  chassisNo     String    @unique
  engineNo      String    @unique
  createdById   Int?
  createdBy     String?
  createdType   String?
  qty           Int
  ratePer       Float
  gstPercent    Float
  amount        Float
  vehicleSrNo   String?
  mfgDate       DateTime?
  keyNo         String?
  batteryMake   String?
  batteryNo     String?
  first1TyerNo  String?
  first2TyerNo  String?
  second1TyerNo String?
  second2TyerNo String?
  location      String?
  grnNumber     String?
  grnDate       DateTime?
  grnRecordDate DateTime?
  status        String    @default("Pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  purchase      Purchase  @relation(fields: [purchaseId], references: [id])
  tractorId     Int?

  tractor Tractor? @relation(fields: [tractorId], references: [id])
}

model Lead {
  id          Int     @id @default(autoincrement())
  quotationNo String? @unique

  modelId     Int?
  variantId   Int?
  colourId    Int?
  customerId  Int?
  executiveId Int?

  wantsFinance            Boolean @default(false)
  existingCustomerModel   String?
  existingCustomerVariant String?
  existingVehicleYear     String?
  customerExpectedPrice   Float?
  marketPrice             Float?

  chassisNo            String?
  companyShare         Float?
  dealerShares         Float?
  rcNo                 String?
  insurance            Float?
  vehicleNo            String?
  financeDoneBy        String?
  financeAmount        Float?
  emi                  Float?
  tenureMonths         Int?
  processingCharge     Float?
  loanROI              Float?
  marginMoney          Float?
  expectedPurchaseDate DateTime?
  expectedDeliveryDate DateTime?
  expectedDeliveryTime String?
  purchaseType         String?
  professionId         Int?
  enquiryTypeId        Int?
  enquirySourceId      Int?
  enquiryStatusId      Int?
  bookingDate          DateTime?
  followUpDate         DateTime?
  dmsEnquiryNo         String?
  dmsEnquiryDate       DateTime?
  otherModel           String?
  competitorTestRide   String?
  salesManagerRemarks  String?
  dealerRemarks        String?
  advancePayment       Boolean   @default(false)
  listOfBooking        Float?
  paymentMode          String?
  bankMode             String?
  accountId            Int?
  narration            String?
  chequeNo             String?
  chequeDate           DateTime?
  chequeClearDate      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  executiveName     String?
  followUpStatus    String?    @default("New")
  showroomVariantId Int?
  order             Order?
  followUps         FollowUp[]
  companyId         Int?
  financialYearId   Int?

  createdType         String?
  createdBy           String?
  branchId            Int?
  teamLeadId          Int?
  branch              Branch?            @relation(fields: [branchId], references: [id])
  teamLead            Employee?          @relation("LeadTeamLead", fields: [teamLeadId], references: [id])
  quotationGrandTotal Float              @default(0)
  company             Company?           @relation(fields: [companyId], references: [id])
  financialYear       FinancialYear?     @relation(fields: [financialYearId], references: [id])
  account             Account?           @relation("LeadAccount", fields: [accountId], references: [id])
  colour              Colour?            @relation(fields: [colourId], references: [id])
  customer            Account?           @relation("LeadCustomer", fields: [customerId], references: [id])
  enquirySourceMaster EnquirySource?     @relation(fields: [enquirySourceId], references: [id])
  enquiryStatus       EnquiryStatus?     @relation(fields: [enquiryStatusId], references: [id])
  enquiryTypeMaster   EnquiryType?       @relation(fields: [enquiryTypeId], references: [id])
  executive           Employee?          @relation("LeadExecutive", fields: [executiveId], references: [id])
  model               Model?             @relation(fields: [modelId], references: [id])
  profession          Profession?        @relation(fields: [professionId], references: [id])
  showroomVariant     ShowroomVariant?   @relation(fields: [showroomVariantId], references: [id])
  variant             Variant?           @relation(fields: [variantId], references: [id])
  cashPayments        CashPayment[]
  bankPayments        BankPayment[]
  cashReceipts        CashReceipt[]
  bankReceipts        BankReceipt[]
  quotationRevision   Int                @default(0)
  quotationHistories  QuotationHistory[]
  testDrives          TestDrive[]

  @@index([teamLeadId])
}

model FollowUp {
  id                   Int       @id @default(autoincrement())
  leadId               Int
  expectedPurchaseDate DateTime?
  nextScheduledDate    DateTime?
  callTime             String?
  callResponse         String?
  discussion           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
