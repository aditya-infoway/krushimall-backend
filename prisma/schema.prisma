model Contra {
  id Int @id @default(autoincrement())

  voucherNo String   @unique
  date      DateTime

  // Cash Deposit | Cash Withdrawal | Bank Transfer
  type String

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  financialYearId Int
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  cashBankAccountId Int
  cashBankAccount   Account @relation("ContraCashBankAccount", fields: [cashBankAccountId], references: [id])

  oppAccountId Int
  oppAccount   Account @relation("ContraOppAccount", fields: [oppAccountId], references: [id])

  amount Float

  narration String?

  createdType String? @default("Manual")
  createdBy   String?
  branchId    Int?
  branch      Branch? @relation("ContraBranch", fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([financialYearId])
  @@index([cashBankAccountId])
  @@index([oppAccountId])
  @@index([date])
  @@index([branchId])
}

model CashReceipt {
  id Int @id @default(autoincrement())

  voucherNo String   @unique
  date      DateTime

  companyId       Int
  financialYearId Int

  cashAccountId Int
  oppAccountId  Int

  leadId    Int?
  jobCardId Int?

  amount    Float
  narration String?
  type      String  @default("CR")

  company       Company       @relation(fields: [companyId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  cashAccount Account @relation("CashReceiptCash", fields: [cashAccountId], references: [id])
  oppAccount  Account @relation("CashReceiptOpp", fields: [oppAccountId], references: [id])

  lead Lead? @relation(fields: [leadId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdType String?
  createdBy   String?
  branchId    Int?
  branch      Branch?  @relation("CashReceiptBranch", fields: [branchId], references: [id])
}

model BankReceipt {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  financialYearId Int
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  voucherNo String   @unique
  date      DateTime

  // BR = Manual Bank Receipt
  // LBR = Lead Bank Receipt
  // JBR = Job Card Bank Receipt
  type String

  bankAccountId Int
  bankAccount   Account @relation("BankReceiptBankAccount", fields: [bankAccountId], references: [id])

  oppAccountId Int
  oppAccount   Account @relation("BankReceiptOppAccount", fields: [oppAccountId], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  amount Float

  paymentType String

  chequeNo        String?
  chequeDate      DateTime?
  chequeClearDate DateTime?

  narration String?

  createdType String?
  createdBy   String?
  branchId    Int?
  branch      Branch? @relation("BankReceiptBranch", fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  financialYearId Int
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  branchCode String @unique
  branchName String
  branchType String

  logo String?

  managerId Int
  manager   Account @relation("BranchManager", fields: [managerId], references: [id])

  mobileNo String
  gmailId  String @unique
  password String

  gstNo     String @unique
  panCardNo String

  address1 String
  address2 String?

  country     String
  countryCode String

  state     String
  stateCode String

  district String
  city     String
  pinCode  String

  createdType String?
  createdBy   String?

  isActive Boolean @default(true)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  vehicleStockTransfers VehicleStockTransfer[]

  leads        Lead[]
  accounts     Account[]     @relation("AccountBranch")
  employees    Employee[]    @relation("EmployeeBranch")
  cashPayments CashPayment[] @relation("CashPaymentBranch")
  cashReceipts CashReceipt[] @relation("CashReceiptBranch")
  bankPayments BankPayment[] @relation("BankPaymentBranch")
  bankReceipts BankReceipt[] @relation("BankReceiptBranch")
  contras      Contra[]      @relation("ContraBranch")

  @@index([companyId])
  @@index([financialYearId])
  @@index([managerId])
}

