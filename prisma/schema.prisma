  financialYearId Int
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  cashAccountId Int
  cashAccount   Account @relation("CashPaymentCashAccount", fields: [cashAccountId], references: [id])

  oppAccountId Int
  oppAccount   Account @relation("CashPaymentOppAccount", fields: [oppAccountId], references: [id])

  purchaseId Int?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  amount Float

  narration String?

  createdType String?
  createdBy   String?

  branchId Int?
  branch   Branch? @relation("CashPaymentBranch", fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankPayment {
  id Int @id @default(autoincrement())

  voucherNo String   @unique
  date      DateTime

  // BP / TPBP
  type String

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  financialYearId Int
  financialYear   FinancialYear @relation(fields: [financialYearId], references: [id])

  bankAccountId Int
  bankAccount   Account @relation("BankPaymentBankAccount", fields: [bankAccountId], references: [id])

